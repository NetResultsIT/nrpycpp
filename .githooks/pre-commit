#!/bin/sh
# pre-commit: .claude/skills must be the copy of .agents/skills, and the shared skills must be unchanged
# (tools/sync_skills.py --check).
# Opt-in, once per clone: git config core.hooksPath .githooks      Bypass once: git commit --no-verify
root=$(git rev-parse --show-toplevel) || exit 0
script="$root/tools/sync_skills.py"
[ -f "$script" ] || exit 0
py=
for cand in python3 python "py -3"; do
    if $cand -c 'import sys; sys.exit(sys.version_info[0] != 3)' >/dev/null 2>&1; then
        py=$cand
        break
    fi
done
if [ -z "$py" ]; then
    echo "skills check: Python 3 not found, check skipped" >&2
    exit 0
fi
out=$($py "$script" --check 2>&1 </dev/null)
rc=$?
[ -n "$out" ] && printf '%s\n' "$out" >&2
if [ "$rc" -eq 1 ]; then
    echo "skills check: blocked. Fix what is listed above, or bypass once with --no-verify." >&2
    exit 1
fi
exit 0
