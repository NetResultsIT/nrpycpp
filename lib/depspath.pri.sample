# Copy this file to depspath.pri and set where the python runtime is.
# Exporting NRPYCPP_PYTHON_ROOT (and optionally NRPYCPP_PYTHON_VERSION) overrides this file.

# Preferred: a relocatable CPython with the python-build-standalone "install_only" layout
# (https://github.com/astral-sh/python-build-standalone), as published on artifactory.
#   unix:    PYTHON_ROOT/include/python3.13, PYTHON_ROOT/lib/libpython3.13.{dylib,so}, PYTHON_ROOT/lib/python3.13
#   windows: PYTHON_ROOT/include, PYTHON_ROOT/libs/python313.lib, PYTHON_ROOT/python313.dll, PYTHON_ROOT/Lib
# PYTHON_ROOT is also used as python home by development builds (see nrPyCppConfig.h).
PYTHON_VERSION = 3.13
PYTHON_ROOT    = /path/to/cpython-3.13-install_only/python

# Legacy: leave PYTHON_ROOT empty and set the following instead
# (the python home must then be found at runtime, see nrPyCppConfig.h)
#PYTHON_VERSION      = 3.9    # on windows without the dot, e.g. 310
#PYTHON_LIB_PATH     = /Applications/Xcode.app/Contents/Developer/Library/Frameworks/Python3.framework/Versions/$${PYTHON_VERSION}/lib/
#PYTHON_INCLUDE_PATH = /Applications/Xcode.app/Contents/Developer/Library/Frameworks/Python3.framework/Versions/$${PYTHON_VERSION}/Headers/
